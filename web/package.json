  },
  "dependencies": {
    "@picocss/pico": "^2.0.6",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/leaflet": "^1.9.14",
    "jsdom": "^30.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
